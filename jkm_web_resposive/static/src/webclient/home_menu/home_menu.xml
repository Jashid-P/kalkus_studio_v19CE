<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="jkm_web_resposive.HomeMenu">
        <div class="o_home_menu h-100 overflow-auto" t-att-class="{ o_ios_app: state.isIosApp }">
            <div class="container">
                <input t-ref="search" type="text" class="o_search_hidden visually-hidden w-auto"
                    data-allow-hotkeys="true" role="combobox"
                    t-on-input="onSearchInput"
                    t-on-blur="onSearchBlur"
                    t-on-compositionstart="onCompositionStart"
                    t-att-aria-activedescendant="'result_app_' + state.focusedIndex"
                    t-att-aria-expanded="displayedApps.length ? 'true' : 'false'"
                    aria-autocomplete="list" aria-haspopup="listbox" autocomplete="off"/>
                <div t-if="displayedApps.length" role="listbox" class="o_apps row user-select-none mt-5 mx-0">
                    <div
                        t-foreach="displayedApps"
                        t-as="app"
                        t-key="app.id"
                        class="col-3 col-md-2 o_draggable mb-3 px-0"
                        draggable="true"
                        t-on-dragstart="(ev) => this.onDragStart(app, ev)"
                        t-on-dragover="onDragOver"
                        t-on-drop="(ev) => this.onDrop(app, ev)"
                    >
                        <a
                            t-att-id="'result_app_' + app_index"
                            role="option"
                            t-att-aria-selected="state.focusedIndex === app_index ? 'true' : 'false'"
                            class="o_app o_menuitem d-flex flex-column rounded-3 justify-content-start align-items-center w-100 p-1 p-md-2"
                            t-att-class="{o_focused: state.focusedIndex === app_index}"
                            t-att-data-menu-xmlid="app.xmlid"
                            t-att-href="app.href"
                            t-on-click.prevent="() => this.selectApp(app)"
                        >
                            <img
                                t-if="app.webIconData"
                                class="o_app_icon rounded-3"
                                t-att-src="app.webIconData"
                                t-att-alt="app.label || app.name"
                            />
                            <div
                                t-else=""
                                class="o_app_icon position-relative d-flex justify-content-center align-items-center p-2 rounded-3 ratio ratio-1x1"
                                t-att-style="'background-color: ' + (app.webIcon?.backgroundColor || '#714B67')"
                            >
                                <i
                                    t-att-class="app.webIcon?.iconClass || 'fa fa-th-large'"
                                    t-att-style="'color: ' + (app.webIcon?.color || '#ffffff')"
                                />
                            </div>
                            <div class="o_caption w-100 text-center text-truncate mt-2">
                                <t t-out="app.label"/>
                            </div>
                        </a>
                    </div>
                </div>
                <div t-else="" id="result_menu_0" role="option" aria-selected="true"
                     class="o_no_result text-center mt-5">
                    No result
                </div>
            </div>
        </div>
    </t>

    <t t-name="jkm_web_resposive.HomeMenu.CommandPalette.Footer">
        <span>
            <span class="fw-bolder text-primary">TIP</span> — open me anywhere with <span t-esc="controlKey" class="fw-bolder text-primary"/> + <span class="fw-bolder text-primary">K</span>
        </span>
    </t>
</templates>
