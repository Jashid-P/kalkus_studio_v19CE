<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- res.groups lost category_id/comment in 19.0; name is all that is set. -->
    <record id="group_fiscal_year" model="res.groups">
        <field name="name">Allow to define fiscal years of more or less than a year</field>
    </record>

    <!--
        Community defines account.group_account_user ("Show Full Accounting
        Features") but grants it to nobody, so every feature gated on it stays
        hidden - including the Reconcile action on Journal Items. Enterprise's
        accountant module is what hands it out; the same wiring is done here,
        otherwise the Accounting app looks complete but half of it is invisible.
    -->
    <record id="base.user_root" model="res.users">
        <field name="group_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <record id="account.group_account_readonly" model="res.groups">
        <field name="name">Read-only</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
    </record>

    <record id="account.group_account_user" model="res.groups">
        <field name="name">Bookkeeper</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
    </record>

    <!-- An accounting manager is a bookkeeper with configuration rights, not a
         biller; swapping the implied group is what promotes the whole app. -->
    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(3, ref('account.group_account_invoice')), (4, ref('account.group_account_user'))]"/>
    </record>
</odoo>
