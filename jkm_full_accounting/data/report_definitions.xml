            <record id="aged_receivable_column_0" model="account.report.column"><field name="name">1–30</field><field name="expression_label">period0</field><field name="figure_type">monetary</field></record>
            <record id="aged_receivable_column_1" model="account.report.column"><field name="name">31–60</field><field name="expression_label">period1</field><field name="figure_type">monetary</field></record>
            <record id="aged_receivable_column_2" model="account.report.column"><field name="name">61–90</field><field name="expression_label">period2</field><field name="figure_type">monetary</field></record>
            <record id="aged_receivable_column_3" model="account.report.column"><field name="name">91–120</field><field name="expression_label">period3</field><field name="figure_type">monetary</field></record>
