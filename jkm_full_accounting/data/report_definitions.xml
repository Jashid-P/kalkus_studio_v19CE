            <record id="aged_payable_column_2" model="account.report.column"><field name="name">61–90</field><field name="expression_label">period2</field><field name="figure_type">monetary</field></record>
            <record id="aged_payable_column_3" model="account.report.column"><field name="name">91–120</field><field name="expression_label">period3</field><field name="figure_type">monetary</field></record>
