<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Bring the Journal Items list up to the Accounting workflow: reconcile a
        selection straight from the list, and turn the matching number into a
        link to the entries it was matched against.
    -->
    <record id="view_move_line_tree_reconcile" model="ir.ui.view">
        <field name="name">account.move.line.list.reconcile</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="mode">extension</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_reconcile" type="object" string="Reconcile"
                            groups="account.group_account_user" data-hotkey="r"/>
                </header>
            </xpath>
            <xpath expr="//list/field[@name='matching_number']" position="attributes">
                <attribute name="widget">matching_link_widget</attribute>
            </xpath>
        </field>
    </record>
</odoo>
