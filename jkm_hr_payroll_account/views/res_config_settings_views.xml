<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_payroll_account" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.payroll.account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Payroll" name="payroll_accounting_setting_container">
                    <setting company_dependent="1"
                             help="Merge the journal entries of all the payslips of a batch and period into a single entry (journal items are no longer per employee)">
                        <field name="batch_payroll_move_lines"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
