<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_payroll" model="ir.ui.view">
        <field name="name">account.move.form.payroll</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_payslips" class="oe_stat_button" icon="fa-book" type="object"
                        invisible="payslip_count == 0" groups="jkm_hr_payroll.group_hr_payroll_user">
                    <field name="payslip_count" widget="statinfo" string="Payslips"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
