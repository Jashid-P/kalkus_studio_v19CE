<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_salary_rule_form_inherit_account" model="ir.ui.view">
        <field name="name">hr.salary.rule.form.account</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="jkm_hr_payroll.hr_salary_rule_form"/>
        <field name="arch" type="xml">
            <page name="description" position="before">
                <page string="Accounting" name="accounting">
                    <group>
                        <group>
                            <field name="account_debit"/>
                            <field name="account_credit"/>
                            <field name="analytic_distribution" widget="analytic_distribution"
                                   groups="analytic.group_analytic_accounting"/>
                        </group>
                        <group>
                            <field name="employee_move_line"/>
                            <field name="split_move_lines"/>
                            <field name="not_computed_in_net"/>
                            <field name="debit_tag_ids" widget="many2many_tags"/>
                            <field name="credit_tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Positive amounts are debited on the debit account and credited on the credit account;
                        negative amounts (e.g. deductions) do the opposite.
                    </div>
                </page>
            </page>
        </field>
    </record>

    <record id="hr_salary_rule_list_inherit_account" model="ir.ui.view">
        <field name="name">hr.salary.rule.list.account</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="jkm_hr_payroll.hr_salary_rule_list"/>
        <field name="arch" type="xml">
            <field name="amount_select" position="after">
                <field name="account_debit" optional="show"/>
                <field name="account_credit" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
