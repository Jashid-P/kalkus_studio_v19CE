<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payroll_structure_form_inherit_account" model="ir.ui.view">
        <field name="name">hr.payroll.structure.form.account</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id" ref="jkm_hr_payroll.view_hr_payroll_structure_form"/>
        <field name="arch" type="xml">
            <field name="country_id" position="after">
                <field name="journal_id"/>
            </field>
            <xpath expr="//field[@name='rule_ids']/list/field[@name='amount_select']" position="after">
                <field name="account_debit" optional="show"/>
                <field name="account_credit" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_payroll_structure_list_inherit_account" model="ir.ui.view">
        <field name="name">hr.payroll.structure.list.account</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id" ref="jkm_hr_payroll.view_hr_payroll_structure_list_view"/>
        <field name="arch" type="xml">
            <field name="type_id" position="after">
                <field name="journal_id" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
