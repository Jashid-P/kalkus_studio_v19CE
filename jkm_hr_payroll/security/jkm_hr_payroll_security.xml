<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_payroll">
        <field name="name">Payroll</field>
        <field name="sequence">15</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_hr_payroll_user" model="res.groups">
        <field name="name">Officer: Manage all payslips</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_payroll"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="comment">The user can create, compute and validate payslips and batches.</field>
    </record>

    <record id="group_hr_payroll_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_payroll"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_payroll_user')), (4, ref('hr.group_hr_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">The user can configure salary structures, rules and parameters.</field>
    </record>

    <data noupdate="1">
        <record id="hr_payslip_comp_rule" model="ir.rule">
            <field name="name">Payslip multi company rule</field>
            <field name="model_id" ref="model_hr_payslip"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="hr_payslip_line_comp_rule" model="ir.rule">
            <field name="name">Payslip line multi company rule</field>
            <field name="model_id" ref="model_hr_payslip_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="hr_payslip_run_comp_rule" model="ir.rule">
            <field name="name">Payslip batch multi company rule</field>
            <field name="model_id" ref="model_hr_payslip_run"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="hr_salary_attachment_comp_rule" model="ir.rule">
            <field name="name">Salary attachment multi company rule</field>
            <field name="model_id" ref="model_hr_salary_attachment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
