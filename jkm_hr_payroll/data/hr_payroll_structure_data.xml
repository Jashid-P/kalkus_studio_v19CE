            <field name="struct_id" ref="structure_regular_pay"/>
            <field name="category_id" ref="DED"/>
            <field name="condition_select">input</field>
            <field name="condition_other_input_id" ref="input_attachment_salary"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -inputs['ATTACH_SALARY'].amount</field>
