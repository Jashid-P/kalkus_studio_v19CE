<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="structure_regular_pay" model="hr.payroll.structure">
            <field name="name">Regular Pay</field>
            <field name="code">REG</field>
            <field name="type_id" ref="hr.structure_type_employee"/>
            <field name="country_id" eval="False"/>
            <field name="rule_ids" eval="[]"/>
            <field name="input_line_type_ids" eval="[(6, 0, [ref('input_bonus'), ref('input_attachment_salary'), ref('input_assignment_salary'), ref('input_child_support'), ref('input_salary_advance'), ref('input_deduction'), ref('input_reimbursement')])]"/>
            <field name="unpaid_work_entry_type_ids" eval="[(6, 0, [ref('hr_work_entry.work_entry_type_unpaid_leave')])]"/>
        </record>
        <record id="hr.structure_type_employee" model="hr.payroll.structure.type">
            <field name="default_struct_id" ref="structure_regular_pay"/>
            <field name="wage_type">monthly</field>
        </record>
        <record id="structure_regular_pay_rule_basic" model="hr.salary.rule">
            <field name="name">Basic Salary</field>
            <field name="code">BASIC</field>
            <field name="sequence">1</field>
            <field name="struct_id" ref="structure_regular_pay"/>
            <field name="category_id" ref="BASIC"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip.paid_amount</field>
        </record>
        <record id="structure_regular_pay_rule_bonus" model="hr.salary.rule">
            <field name="name">Bonus</field>
            <field name="code">BONUS</field>
            <field name="sequence">20</field>
            <field name="struct_id" ref="structure_regular_pay"/>
            <field name="category_id" ref="ALW"/>
            <field name="condition_select">input</field>
            <field name="condition_other_input_id" ref="input_bonus"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs['BONUS'].amount</field>
        </record>
        <record id="structure_regular_pay_rule_gross" model="hr.salary.rule">
            <field name="name">Gross</field>
            <field name="code">GROSS</field>
            <field name="sequence">100</field>
            <field name="struct_id" ref="structure_regular_pay"/>
            <field name="category_id" ref="GROSS"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = categories['BASIC'] + categories['ALW']</field>
        </record>
        <record id="structure_regular_pay_rule_attach_salary" model="hr.salary.rule">
            <field name="name">Attachment of Salary</field>
