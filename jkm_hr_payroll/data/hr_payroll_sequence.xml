<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_salary_slip" model="ir.sequence">
            <field name="name">Salary Slip</field>
            <field name="code">salary.slip</field>
            <field name="prefix">SLIP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_salary_slip_refund" model="ir.sequence">
            <field name="name">Salary Slip Refund</field>
            <field name="code">salary.slip.refund</field>
            <field name="prefix">RSLIP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
