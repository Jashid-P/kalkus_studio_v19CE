<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_new_payslip" model="mail.template">
            <field name="name">Payroll: Payslip</field>
            <field name="model_id" ref="model_hr_payslip"/>
            <field name="subject">{{ object.employee_id.name }}, your payslip for {{ object._get_period_name() }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.employee_id.work_contact_id.id or '' }}</field>
            <field name="report_template_ids" eval="[(4, ref('jkm_hr_payroll.action_report_payslip'))]"/>
            <field name="description">Sent to employees with their payslip attached</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.employee_id.name or ''">Marc Demo</t>,
        <br/><br/>
        Please find attached your payslip for <t t-out="object._get_period_name() or ''">May 2026</t>.
        <br/><br/>
        Net amount: <strong t-out="format_amount(object.net_wage, object.currency_id) or ''">$ 3,000.00</strong>
        <br/><br/>
        Best regards,
        <br/>
        <t t-out="object.company_id.name or ''">YourCompany</t>
    </p>
</div>
            </field>
            <field name="lang">{{ object.employee_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
