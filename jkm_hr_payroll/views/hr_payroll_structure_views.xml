<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payroll_structure_list_view" model="ir.ui.view">
        <field name="name">hr.payroll.structure.list</field>
        <field name="model">hr.payroll.structure</field>
        <field name="arch" type="xml">
            <list string="Salary Structures">
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="type_id"/>
                <field name="country_id" optional="show"/>
                <field name="rule_count" string="Rules"/>
            </list>
        </field>
    </record>

    <record id="view_hr_payroll_structure_form" model="ir.ui.view">
        <field name="name">hr.payroll.structure.form</field>
        <field name="model">hr.payroll.structure</field>
        <field name="arch" type="xml">
            <form string="Salary Structure">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_rules" class="oe_stat_button" icon="fa-list" type="object">
                            <field name="rule_count" widget="statinfo" string="Salary Rules"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Regular Pay"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="type_id"/>
                            <field name="code"/>
                            <field name="country_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="schedule_pay"/>
                            <field name="payslip_name"/>
                            <field name="use_worked_day_lines"/>
                            <field name="proration_method" invisible="not use_worked_day_lines"/>
                            <field name="report_id"/>
                            <field name="hide_basic_on_pdf"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Salary Rules" name="salary_rules">
                            <field name="rule_ids" context="{'default_struct_id': id}">
                                <list decoration-muted="not active">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="category_id"/>
                                    <field name="amount_select"/>
                                    <field name="condition_select" optional="hide"/>
                                    <field name="appears_on_payslip" optional="show"/>
                                    <field name="active" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Worked Days &amp; Inputs" name="inputs">
                            <group>
                                <field name="unpaid_work_entry_type_ids" widget="many2many_tags"/>
                                <field name="input_line_type_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Description" name="description">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_payroll_structure_filter" model="ir.ui.view">
        <field name="name">hr.payroll.structure.select</field>
        <field name="model">hr.payroll.structure</field>
        <field name="arch" type="xml">
            <search string="Salary Structures">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="type_id"/>
                <field name="country_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Structure Type" name="group_by_type" context="{'group_by': 'type_id'}"/>
                    <filter string="Country" name="group_by_country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_payroll_structure" model="ir.actions.act_window">
        <field name="name">Structures</field>
        <field name="res_model">hr.payroll.structure</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_payroll_structure_filter"/>
    </record>
</odoo>
