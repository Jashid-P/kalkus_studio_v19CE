<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payroll_structure_type_view_tree" model="ir.ui.view">
        <field name="name">hr.payroll.structure.type.list</field>
        <field name="model">hr.payroll.structure.type</field>
        <field name="arch" type="xml">
            <list string="Salary Structure Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="default_struct_id"/>
                <field name="wage_type"/>
                <field name="default_schedule_pay"/>
                <field name="default_resource_calendar_id" optional="show"/>
                <field name="country_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="hr_payroll_structure_type_view_form" model="ir.ui.view">
        <field name="name">hr.payroll.structure.type.form</field>
        <field name="model">hr.payroll.structure.type</field>
        <field name="arch" type="xml">
            <form string="Salary Structure Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_structures" class="oe_stat_button" icon="fa-sitemap" type="object">
                            <field name="struct_count" widget="statinfo" string="Structures"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Employee"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="default_struct_id" options="{'no_create': True}"/>
                            <field name="wage_type"/>
                            <field name="default_schedule_pay"/>
                        </group>
                        <group>
                            <field name="default_resource_calendar_id"/>
                            <field name="default_work_entry_type_id"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_payroll_structure_type" model="ir.actions.act_window">
        <field name="name">Structure Types</field>
        <field name="res_model">hr.payroll.structure.type</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('hr_payroll_structure_type_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hr_payroll_structure_type_view_form')})]"/>
    </record>
</odoo>
